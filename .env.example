COMPOSE_PROJECT_NAME=buy-land
CONTAINER_ENGINE=docker
DATABASE_USERNAME=buy_land_app
DATABASE_PASSWORD=
AUTH_JWT_SECRET=
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=buy-land-api
POSTGRES_PORT=15432
DATABASE_URL=jdbc:postgresql://localhost:15432/buy_land
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
PLATFORM_API_DOCS_ENABLED=true
